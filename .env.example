# One Cookie per line. In .env files, use \n inside the quoted value.
JAVBUS_COOKIES="example_cookie_one\nexample_cookie_two"
FULIBA_USERNAMES="example_user_one\nexample_user_two"
FULIBA_COOKIES="example_cookie_one\nexample_cookie_two"
V2EX_USERNAMES='example_user_one\nexample_user_two'
# Use outer single quotes because the complete V2EX Cookie may contain double quotes.
V2EX_COOKIES='example_cookie_one\nexample_cookie_two'

# Optional signed robot notifications. Leave both values empty to disable a channel.
# DingTalk access token is only the value after access_token=, not the full Webhook URL.
DINGTALK_ACCESS_TOKEN=
DINGTALK_SECRET=
FEISHU_WEBHOOK=
FEISHU_SECRET=

# Notification routing: auto (DingTalk first), all, dingtalk, or feishu.
CHECKIN_NOTIFY_CHANNEL=auto
# Message mode: summary or individual.
CHECKIN_NOTIFY_MODE=summary

# Optional runtime overrides.
JAVBUS_BASE_URL=https://www.javbus.com
FULIBA_BASE_URL=https://www.wnflb2023.com
V2EX_BASE_URL=https://www.v2ex.com
CHECKIN_TIMEOUT_SECONDS=20
CHECKIN_RETRIES=2
