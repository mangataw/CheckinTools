# One Cookie per line. In .env files, use \n inside the quoted value.
JAVBUS_COOKIES="example_cookie_one\nexample_cookie_two"
FULIBA_USERNAMES="example_user_one\nexample_user_two"
FULIBA_COOKIES="example_cookie_one\nexample_cookie_two"

# Optional signed robot notifications. Leave both values empty to disable a channel.
DINGTALK_ACCESS_TOKEN=
DINGTALK_SECRET=
FEISHU_WEBHOOK=
FEISHU_SECRET=

# Optional runtime overrides.
JAVBUS_BASE_URL=https://www.javbus.com
FULIBA_BASE_URL=https://www.wnflb2023.com
CHECKIN_TIMEOUT_SECONDS=20
CHECKIN_RETRIES=2

