# CheckinTools 青龙集中配置模板
# 订阅仅在 /ql/data/config/checkin-tools.env 不存在时复制本模板。
# 请在青龙“配置文件”中编辑复制后的文件，不要编辑仓库目录中的本文件。
# 多账号使用字面量 \n 分隔；Cookie 建议使用单引号。

# ── JavBus ─────────────────────────────────────────────────────────────
JAVBUS_COOKIES=''

# ── 福利吧 ─────────────────────────────────────────────────────────────
# 用户名与 Cookie 必须按相同行号一一对应。
FULIBA_USERNAMES=''
FULIBA_COOKIES=''

# ── V2EX ───────────────────────────────────────────────────────────────
# 用户名与 Cookie 必须按相同行号一一对应。
V2EX_USERNAMES=''
V2EX_COOKIES=''

# ── 站点地址 ───────────────────────────────────────────────────────────
JAVBUS_BASE_URL='https://www.javbus.com'
FULIBA_BASE_URL='https://www.wnflb2023.com'
V2EX_BASE_URL='https://www.v2ex.com'

# ── 网络请求 ───────────────────────────────────────────────────────────
CHECKIN_TIMEOUT_SECONDS='20'
CHECKIN_RETRIES='2'

# ── 通知 ───────────────────────────────────────────────────────────────
DINGTALK_ACCESS_TOKEN=''
DINGTALK_SECRET=''
FEISHU_WEBHOOK=''
FEISHU_SECRET=''
# auto、all、dingtalk 或 feishu
CHECKIN_NOTIFY_CHANNEL='auto'
# summary 或 individual
CHECKIN_NOTIFY_MODE='summary'

# ── 青龙持久化状态 ─────────────────────────────────────────────────────
CHECKIN_QINGLONG_DATA_DIR='/ql/data/checkin-tools'
